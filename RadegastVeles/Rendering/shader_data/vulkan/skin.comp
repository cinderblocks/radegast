#version 310 es

// Vulkan variant of ../skin.comp. No license header at the top of this file deliberately --
// SPIR-V's ES-profile parser requires #version to be the literal first token, not even
// preceded by a comment, matching every other file in this vulkan/ subfolder
// (prim.vert/prim.frag/wireframe.vert/etc., none of which carry the header either, for the
// same reason).
//
// Same #define-aliasing approach as prim.vert/prim.frag: every line of main()/readSkinMat()
// below is byte-identical to the GL original, only the declarations changed. Two real
// differences from the GL original, both mechanical:
//   - Every layout(std430, binding=N) SSBO gains an explicit set=0 (GL has one flat binding
//     namespace; Vulkan scopes bindings per descriptor set).
//   - The loose `uniform int uVertexCount` becomes a push-constant field -- Vulkan has no
//     support for non-opaque loose uniforms at all.
// No #version bump needed -- the GL original is already "#version 310 es".
layout(local_size_x = 64) in;

// Binding 0: T-pose vertex data (12 floats per vertex: X,Y,Z, NX,NY,NZ, U,V, TX,TY,TZ, TW).
layout(std430, set = 0, binding = 0) readonly buffer BindVerts { highp float bv[]; };

// Binding 1: Joint indices (4 ints per vertex, matching Joints[] in AvatarFaceSkinData).
layout(std430, set = 0, binding = 1) readonly buffer Joints    { int ji[]; };

// Binding 2: Blend weights (4 floats per vertex, matching Weights[] in AvatarFaceSkinData).
layout(std430, set = 0, binding = 2) readonly buffer Weights   { highp float wt[]; };

// Binding 3: Skin matrices — one mat4 per joint.
// Stored as raw System.Numerics.Matrix4x4 bytes (row-major); reading as mat4() gives M_r^T so
// M_gl * v = M_r^T * v_col = TransformRow(v, M_r).  No pre-transpose needed (same identity
// VkPerFrameUbo.cs's own "Matrix upload convention" note relies on for the main pass).
layout(std430, set = 0, binding = 3) readonly buffer SkinMats  { highp float sm[]; };

// Binding 4: Output vertex buffer — this IS the mesh VBO read by the vertex shader.
layout(std430, set = 0, binding = 4) buffer OutVerts           { highp float ov[]; };

layout(push_constant) uniform PushConstants { int uVertexCount; } pc;
#define uVertexCount pc.uVertexCount

highp mat4 readSkinMat(int idx)
{
    int b = idx * 16;
    return mat4(
        sm[b +  0], sm[b +  1], sm[b +  2], sm[b +  3],
        sm[b +  4], sm[b +  5], sm[b +  6], sm[b +  7],
        sm[b +  8], sm[b +  9], sm[b + 10], sm[b + 11],
        sm[b + 12], sm[b + 13], sm[b + 14], sm[b + 15]
    );
}

void main()
{
    uint vi = gl_GlobalInvocationID.x;
    if (vi >= uint(uVertexCount)) return;

    int b = int(vi) * 12;
    highp vec4 bp = vec4(bv[b],     bv[b + 1], bv[b + 2], 1.0);
    highp vec4 bn = vec4(bv[b + 3], bv[b + 4], bv[b + 5], 0.0);
    highp vec4 bt = vec4(bv[b + 8], bv[b + 9], bv[b + 10], 0.0);

    highp vec4  ap     = vec4(0.0);
    highp vec4  an     = vec4(0.0);
    highp vec4  at     = vec4(0.0);
    highp float totalW = 0.0;

    for (int k = 0; k < 4; k++)
    {
        int         j = ji[int(vi) * 4 + k];
        highp float w = wt[int(vi) * 4 + k];
        if (w <= 1e-4) continue;

        highp mat4 m = readSkinMat(j);
        ap     += w * (m * bp);
        an     += w * (m * bn);
        at     += w * (m * bt);
        totalW += w;
    }

    if (totalW <= 1e-4) { ap = bp; an = bn; at = bt; }

    ov[b]      = ap.x;
    ov[b + 1]  = ap.y;
    ov[b + 2]  = ap.z;
    ov[b + 3]  = an.x;
    ov[b + 4]  = an.y;
    ov[b + 5]  = an.z;
    ov[b + 6]  = bv[b + 6];
    ov[b + 7]  = bv[b + 7];
    ov[b + 8]  = at.x;
    ov[b + 9]  = at.y;
    ov[b + 10] = at.z;
    ov[b + 11] = bv[b + 11];
}
