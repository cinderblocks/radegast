<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>Radegast Veles</AssemblyTitle>
    <RootNamespace>Radegast.Veles</RootNamespace>
    <AssemblyName>RadegastVeles</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <OutputPath>..\bin\Veles\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>Assets\veles.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BenchmarkSuite1</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <!-- BugsplatDatabase can be overridden at build time: /p:BugsplatDatabase=mydb -->
    <BugsplatDatabase Condition="'$(BugsplatDatabase)' == ''"></BugsplatDatabase>
  </PropertyGroup>
  <ItemGroup>
    <!-- Baked into the assembly's metadata attributes; read at runtime via
         Assembly.GetExecutingAssembly().GetCustomAttributes<AssemblyMetadataAttribute>() -->
    <AssemblyMetadata Include="BugsplatDatabase" Value="$(BugsplatDatabase)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="BugSplatDotNetStandard" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
    <PackageReference Include="NetSparkleUpdater.UI.Avalonia" Version="3.1.0" />
    <!-- sherpa-onnx: managed API + platform-specific native runtimes -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="1.13.3" />
    <PackageReference Include="CoreJ2K.Avalonia" Version="2.3.3.91" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="XenoAtom.ShaderCompiler.Build" Version="1.2.2" />
  </ItemGroup>
  <PropertyGroup>
    <EnableDefaultShaderCompileItems>false</EnableDefaultShaderCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ShaderCompile Include="Rendering\shader_data\vulkan\*.vert;Rendering\shader_data\vulkan\*.frag;Rendering\shader_data\vulkan\*.comp">
      <ShaderCompilerOption_output_kind>content</ShaderCompilerOption_output_kind>
      <ShaderCompilerOption_target_env>vulkan1.0</ShaderCompilerOption_target_env>
    </ShaderCompile>
    <ShaderCompilerGlobalOption_include_directory Include="Rendering\shader_data\vulkan" />
  </ItemGroup>
  <Target Name="EmbedPackageReferenceMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="PackageRef_%(PackageReference.Identity)" Value="%(PackageReference.Version)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Radegast.Core\Radegast.Core.csproj" />
    <ProjectReference Include="..\Radegast.Veles.PluginApi\Radegast.Veles.PluginApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\veles.ico" />
    <AvaloniaResource Include="Assets\veles.png" />
    <AvaloniaResource Include="Assets\sidebar.png" />
    <AvaloniaResource Include="Rendering\shader_data\normalmap.png" />
    <AvaloniaResource Include="Rendering\shader_data\dudvmap.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Radegast\grids.xml" Link="grids.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyNativeAssemblies" AfterTargets="PostBuildEvent" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="xcopy /y &quot;$(MSBuildThisFileDirectory)..\Radegast.Core\assemblies\x64&quot; &quot;$(OutDir)dll\x64\&quot; /E/I" />
    <Exec Command="xcopy /y &quot;$(MSBuildThisFileDirectory)..\Radegast.Core\assemblies\x86&quot; &quot;$(OutDir)dll\x86\&quot; /E/I" />
    <Exec Command="xcopy /y &quot;$(MSBuildThisFileDirectory)..\Radegast.Core\assemblies\arm64&quot; &quot;$(OutDir)dll\arm64\&quot; /E/I" />
  </Target>
  <!-- macOS/Linux equivalent of CopyNativeAssemblies above, done here rather than in
       Radegast.Core.csproj (where fmod's actual DllImport lives): confirmed by a local
       `dotnet publish -r osx-arm64` test that $(RuntimeIdentifier) does NOT propagate down into
       a multi-targeted (net481;net10.0) ProjectReference's own MSBuild evaluation, an
       equivalent Condition placed in Radegast.Core.csproj silently never fired. RadegastVeles.csproj
       is the actual project `dotnet publish -r <RID>` is invoked against, so $(RuntimeIdentifier)
       is guaranteed set here. The Windows CopyNativeAssemblies target above only fires when the
       MSBuild host itself is Windows, never true on the macOS/Linux CI runners that publish those
       platforms, so fmod's native library never made it into those publish outputs at all;
       WindowsLibraryLoader (Radegast.Core/NativeMethods.cs) only loads on Windows too, so on
       macOS/Linux this instead relies on the .NET runtime's own default P/Invoke probing for a
       bare [DllImport("fmod")], which finds "lib" + name + ".dylib"/".so" automatically as long
       as the file sits next to the assembly, no custom loader needed, just get it copied there. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <None Include="..\Radegast.Core\assemblies\libfmod.dylib" CopyToOutputDirectory="PreserveNewest" Link="libfmod.dylib" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <!-- assemblies\libfmod.so / libfmod.so.12 are supposed to be symlinks to this real file,
         chained the way the upstream FMOD SDK ships them (SONAME-versioned .so), but git on
         Windows checked them in as empty regular files instead of preserving the symlinks.
         Ship the real file directly under the plain name instead of relying on that chain. -->
    <None Include="..\Radegast.Core\assemblies\libfmod.so.12.10" CopyToOutputDirectory="PreserveNewest" Link="libfmod.so" />
  </ItemGroup>
</Project>
