<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <AssemblyTitle>Radegast.Core</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugType>full</DebugType>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
    <ItemGroup>
    <PackageReference Include="LibreMetaverse" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.Imaging.Skia" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.LslTools" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.PrimMesher" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.Rendering.MeshFoundry" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.RLV" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.StructuredData" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.Types" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.Utilities" Version="3.1.5" />
    <PackageReference Include="LibreMetaverse.Voice.WebRTC" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CoreJ2K.Skia" Version="2.3.3.91" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.10" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.11" />
  </ItemGroup>
  <!-- Bakes every PackageReference's id+version into this assembly's metadata attributes so
       RadegastVeles' About dialog (AboutWindow.axaml.cs, PopulateLibraries) can credit them at
       runtime, in addition to its own direct PackageReferences, without going stale.
       Metadata-batching (%(...)) only expands inside a Target, so this has to run as a
       Target rather than a bare ItemGroup. -->
  <Target Name="EmbedPackageReferenceMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="PackageRef_%(PackageReference.Identity)" Value="%(PackageReference.Version)" />
    </ItemGroup>
  </Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="xcopy /y &quot;$(ProjectDir)assemblies\x64&quot; &quot;$(OutDir)dll\x64&quot; /E/I" />
    <Exec Command="xcopy /y &quot;$(ProjectDir)assemblies\x86&quot; &quot;$(OutDir)dll\x86&quot; /E/I" />
    <Exec Command="xcopy /y &quot;$(ProjectDir)assemblies\arm64&quot; &quot;$(OutDir)dll\arm64&quot; /E/I" />
  </Target>
  <!-- macOS/Linux equivalent of the PostBuild target above. That one only fires when the MSBuild
       host itself is Windows ('$(OS)'=='Windows_NT'), which is never true on the macOS/Linux CI
       runners that publish those platforms, so fmod's native library never made it into
       those publish outputs at all. WindowsLibraryLoader (NativeMethods.cs) only loads on
       Windows too, so on macOS/Linux this relies on the .NET runtime's own default P/Invoke
       probing for a bare [DllImport("fmod")], which finds "lib" + name + ".dylib"/".so"
       automatically as long as the file sits next to the assembly, no custom loader needed,
       just get it copied there. Conditioned on RuntimeIdentifier (set by `dotnet publish -r`),
       not host OS, since these targets cross-build from any host. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <None Include="assemblies\libfmod.dylib" CopyToOutputDirectory="PreserveNewest" Link="libfmod.dylib" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <!-- assemblies\libfmod.so / libfmod.so.12 are supposed to be symlinks to this real file,
         chained the way the upstream FMOD SDK ships them (SONAME-versioned .so), but git on
         Windows checked them in as empty regular files instead of preserving the symlinks.
         Ship the real file directly under the plain name instead of relying on that chain. -->
    <None Include="assemblies\libfmod.so.12.10" CopyToOutputDirectory="PreserveNewest" Link="libfmod.so" />
  </ItemGroup>
</Project>
